---
import Layout from '../layouts/Layout.astro';
import { SITE_URL } from '../data/site-config';
---

<Layout
  title="Sidan hittades inte | Lön Efter Skatt"
  description="Sidan du letar efter finns inte eller har flyttats."
  canonical={`${SITE_URL}/404/`}
>
  <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6 text-center">
    <p class="text-7xl font-bold text-brand-500">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
      Sidan hittades inte
    </h1>
    <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
      Sidan du letar efter finns inte eller har flyttats. Kontrollera adressen eller gå tillbaka till startsidan.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-xl bg-brand-500 px-6 py-3 text-white font-semibold hover:bg-brand-600 transition-colors"
    >
      Tillbaka till startsidan
    </a>
  </div>
</Layout>
