    <thead><tr><th>Bruttolön/mån</th><th>JSA/år (ca)</th><th>JSA/mån</th></tr></thead>
    <tbody>
      <tr><td>20 000 kr</td><td>~20 000 kr</td><td>~1 700 kr</td></tr>
