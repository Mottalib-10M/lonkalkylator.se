---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { calculateTakeHome } from '../../../lib/tax-engine-se';
import { DEFAULT_KOMMUNALSKATT } from '../../../data/tax-2026';
const kr = (x: number) => Math.round(x).toLocaleString('sv-SE') + ' kr';
const kronor = (x: number) => Math.round(x).toLocaleString('sv-SE') + ' kronor';
const pct = (x: number) => x.toLocaleString('sv-SE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const R = (m: number, rate?: number) => calculateTakeHome({ monthlyGross: m, kommunalskattRate: rate });
const JSA_RADER = [20000, 25000, 30000, 35000, 40000, 50000].map((m) => ({ m, r: R(m) }));
const r20 = R(20000), r30lag = R(30000, 30), r30hog = R(30000, 35), r35 = R(35000), r35lag = R(35000, 29), r35hog = R(35000, 35), r40 = R(40000);
import OfficiellaKallor from '../../../components/OfficiellaKallor.astro';
import MiniSimAutonome from '../../../components/calc/MiniSimAutonome';
---

<GuideLayout
  title="Jobbskatteavdraget förklarat: så mycket är det värt"
  description="Så fungerar jobbskatteavdraget i Sverige: beräkning, nivåer och hur det påverkar din nettolön 2026. Komplett guide med beräkningsexempel och skattesatser."
