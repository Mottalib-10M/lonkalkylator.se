---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { LON_AVSNITT } from '../../data/angles-lokalt';
import LonKalkylator from '../../components/calculators/LonKalkylator';
import { SALARY_AMOUNTS, KOMMUNER } from '../../data/tax-2026';
import { calculateTakeHome } from '../../lib/tax-engine-se';
import { formatKr } from '../../lib/format';
import { getSalaryPageContent } from '../../lib/salary-content';

/** Le taux s'ecrit a la suedoise, virgule decimale, dans le texte ET dans le JSON-LD. */
const taux = (v: number) => v.toLocaleString('sv-SE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });


export function getStaticPaths() {
  return SALARY_AMOUNTS.map(amount => ({
    params: { slug: String(amount) },
    props: { amount },
  }));
}

const { amount } = Astro.props;
const content = getSalaryPageContent(amount);
const { result, faqs, bandContext, careerDescription, taxTips, raiseSimulation, budgetBreakdown, uniqueComparisons, employerCost, annualTimeline, purchasingPower, pensionProjection } = content;
const formattedAmount = new Intl.NumberFormat('sv-SE').format(amount);

// Variera ordning av sektioner baserat på belopp för att öka uniqueness
const sectionOrder = Math.floor(amount / 5000) % 4;

// Välj vilka kommuner som visas (olika för varje belopp)
const kommunOffset = Math.floor(amount / 10000) % 3;
const visadeKommuner = KOMMUNER.slice(kommunOffset * 3, kommunOffset * 3 + 10).slice(0, 8);
---

<CalculatorLayout
  slug={`/lon/${amount}`}
  title={`${formattedAmount} kr i lön`}
  metaTitle={`${formattedAmount} kr i lön efter skatt 2026 | Nettolön ${formatKr(result.netMonthly)}`}
  metaDescription={`Se nettolön vid ${formattedAmount} kr bruttolön per månad 2026. Nettolönen blir ca ${formatKr(result.netMonthly)}/mån med genomsnittlig kommunalskatt. Skatteuppdelning och jämförelse.`}
  h1={`${formattedAmount} kr i lön efter skatt 2026`}
  intro={`Med en bruttolön på ${formattedAmount} kr per månad blir din lön efter skatt ungefär ${formatKr(result.netMonthly)} per månad med genomsnittlig kommunalskatt. Se den fullständiga skatteberäkningen nedan.`}
  faqs={faqs}
>
  <div data-chrome>
    <LonKalkylator client:idle initialGross={amount} />
  </div>

  <section data-chrome class="mt-12 prose prose-gray dark:prose-invert max-w-none" slot="content">
    <h2>Vad innebär {formattedAmount} kr i lön efter skatt per månad?</h2>
    <p>{bandContext}</p>

    <h3>Typiska yrken vid {formattedAmount} kr i lön</h3>
    <p>{careerDescription}</p>

    <h3>Skatteuppdelning vid {formattedAmount} kr bruttolön</h3>
    <p>
      Din kommunalskatt utgör den största delen av skatten och uppgår till {formatKr(result.kommunalskatt)} per år
      med genomsnittlig skattesats. Grundavdraget på {formatKr(result.grundavdrag)} minskar din beskattningsbara inkomst
      till {formatKr(result.taxableIncome)}.
      {result.statligSkatt > 0
        ? ` Utöver kommunalskatten betalar du ${formatKr(result.statligSkatt)} per år i statlig inkomstskatt eftersom din beskattningsbara inkomst överstiger skiktgränsen.`
        : ' Du betalar ingen statlig inkomstskatt vid denna inkomstnivå.'}
      {` Jobbskatteavdraget på ${formatKr(result.jobbskatteavdrag)} per år och pensionsavgiftsreduktionen på ${formatKr(result.pensionsavgiftReduktion)} minskar din slutliga skattebörda till ${formatKr(result.totalSkatt)} per år.`}
    </p>

    {sectionOrder === 0 && (
      <>
        <h3>Skattetips vid {formattedAmount} kr i lön</h3>
        <p>{taxTips}</p>

        <h3>Arbetsgivarens kostnad vid {formattedAmount} kr bruttolön</h3>
        <p>{employerCost}</p>

        <h3>Löneökning från {formattedAmount} kr — så påverkas nettolönen</h3>
        <p>{raiseSimulation}</p>

        <h3>Månadsbudget vid {formattedAmount} kr bruttolön</h3>
        <p>{budgetBreakdown}</p>

        <h3>Årsöversikt för {formattedAmount} kr i månadslön</h3>
        <p>{annualTimeline}</p>

        <h3>Köpkraft och levnadskostnader vid {formattedAmount} kr</h3>
        <p>{purchasingPower}</p>

        <h3>Pensionsuppbyggnad vid {formattedAmount} kr i lön</h3>
        <p>{pensionProjection}</p>

        <h3>Jämförelse med andra lönenivåer</h3>
        <p>{uniqueComparisons}</p>
      </>
    )}

    {sectionOrder === 1 && (
      <>
        <h3>Arbetsgivarens kostnad vid {formattedAmount} kr bruttolön</h3>
        <p>{employerCost}</p>

        <h3>Köpkraft och levnadskostnader vid {formattedAmount} kr</h3>
        <p>{purchasingPower}</p>

        <h3>Skattetips vid {formattedAmount} kr i lön</h3>
        <p>{taxTips}</p>

        <h3>Jämförelse med andra lönenivåer</h3>
        <p>{uniqueComparisons}</p>

        <h3>Löneökning från {formattedAmount} kr — så påverkas nettolönen</h3>
        <p>{raiseSimulation}</p>

        <h3>Pensionsuppbyggnad vid {formattedAmount} kr i lön</h3>
        <p>{pensionProjection}</p>

        <h3>Årsöversikt för {formattedAmount} kr i månadslön</h3>
        <p>{annualTimeline}</p>

        <h3>Månadsbudget vid {formattedAmount} kr bruttolön</h3>
        <p>{budgetBreakdown}</p>
      </>
    )}

    {sectionOrder === 2 && (
      <>
        <h3>Löneökning från {formattedAmount} kr — så påverkas nettolönen</h3>
        <p>{raiseSimulation}</p>

        <h3>Pensionsuppbyggnad vid {formattedAmount} kr i lön</h3>
        <p>{pensionProjection}</p>

        <h3>Månadsbudget vid {formattedAmount} kr bruttolön</h3>
        <p>{budgetBreakdown}</p>

        <h3>Arbetsgivarens kostnad vid {formattedAmount} kr bruttolön</h3>
        <p>{employerCost}</p>

        <h3>Skattetips vid {formattedAmount} kr i lön</h3>
        <p>{taxTips}</p>

        <h3>Köpkraft och levnadskostnader vid {formattedAmount} kr</h3>
        <p>{purchasingPower}</p>

        <h3>Jämförelse med andra lönenivåer</h3>
        <p>{uniqueComparisons}</p>

        <h3>Årsöversikt för {formattedAmount} kr i månadslön</h3>
        <p>{annualTimeline}</p>
      </>
    )}

    {sectionOrder === 3 && (
      <>
        <h3>Månadsbudget vid {formattedAmount} kr bruttolön</h3>
        <p>{budgetBreakdown}</p>

        <h3>Köpkraft och levnadskostnader vid {formattedAmount} kr</h3>
        <p>{purchasingPower}</p>

        <h3>Årsöversikt för {formattedAmount} kr i månadslön</h3>
        <p>{annualTimeline}</p>

        <h3>Skattetips vid {formattedAmount} kr i lön</h3>
        <p>{taxTips}</p>

        <h3>Löneökning från {formattedAmount} kr — så påverkas nettolönen</h3>
        <p>{raiseSimulation}</p>

        <h3>Arbetsgivarens kostnad vid {formattedAmount} kr bruttolön</h3>
        <p>{employerCost}</p>

        <h3>Pensionsuppbyggnad vid {formattedAmount} kr i lön</h3>
        <p>{pensionProjection}</p>

        <h3>Jämförelse med andra lönenivåer</h3>
        <p>{uniqueComparisons}</p>
      </>
    )}

    <h3>Jämförelse mellan kommuner vid {formattedAmount} kr</h3>
    <p>
      Din nettolön varierar beroende på var du bor. Här är några exempel vid {formattedAmount} kr bruttolön:
    </p>
    <div class="overflow-x-auto not-prose">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b-2 border-gray-300 dark:border-gray-600">
            <th class="px-3 py-2 text-left font-semibold">Kommun</th>
            <th class="px-3 py-2 text-right font-semibold">Skattesats</th>
            <th class="px-3 py-2 text-right font-semibold">Nettolön per månad</th>
            <th class="px-3 py-2 text-right font-semibold">Skatt per månad</th>
          </tr>
        </thead>
        <tbody>
          {visadeKommuner.map((k) => {
            const r = calculateTakeHome({ monthlyGross: amount, kommunalskattRate: k.rate, begravningsavgiftRate: k.begravning });
            return (
              <tr class="border-b border-gray-100 dark:border-gray-700 last:border-0">
                <td class="px-3 py-2 font-medium">{k.name}</td>
                <td class="px-3 py-2 text-right tabular-nums">{taux(k.rate)}&nbsp;%</td>
                <td class="px-3 py-2 text-right tabular-nums font-semibold">{formatKr(r.netMonthly)}</td>
                <td class="px-3 py-2 text-right tabular-nums text-gray-500">{formatKr(amount - r.netMonthly)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section data-chrome class="mt-12 not-prose" slot="content" aria-labelledby="sources-heading">
    <h2 id="sources-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-4">
      Källor och referenser
    </h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
      Alla beräkningar baseras på officiella uppgifter från svenska myndigheter för skatteår 2026.
    </p>
    <ul class="space-y-3">
      <li class="flex items-start gap-2">
        <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
        <div>
          <a href="https://skatteverket.se" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 hover:underline">
            Skatteverket
          </a>
          <span class="text-gray-500 dark:text-gray-400">, Skattetabeller, grundavdrag och regler för inkomstskatt 2026</span>
        </div>
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
        <div>
          <a href="https://scb.se" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 hover:underline">
            SCB – Statistiska centralbyrån
          </a>
          <span class="text-gray-500 dark:text-gray-400">, Lönestatistik och ekonomiska uppgifter för Sverige</span>
        </div>
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
        <div>
          <a href="https://pensionsmyndigheten.se" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 hover:underline">
            Pensionsmyndigheten
          </a>
          <span class="text-gray-500 dark:text-gray-400">, Information om allmän pension och pensionsavgifter</span>
        </div>
      </li>
    </ul>
  </section>
  <section slot="content" class="mt-12">
    {(LON_AVSNITT[amount] ?? []).map((a) => (
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">{a.rubrik}</h2>
        {a.stycken.map((p) => <p class="mb-4 text-gray-700 leading-relaxed dark:text-gray-300">{p}</p>)}
      </div>
    ))}
  </section>
</CalculatorLayout>
