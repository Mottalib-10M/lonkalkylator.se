---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import TimlonKalkylator from '../../components/calculators/TimlonKalkylator';

const faqs = [
  { question: 'Hur omvandlar jag timlön till månadslön?', answer: 'Multiplicera din timlön med antalet arbetstimmar per vecka och 52 veckor, dela sedan med 12. Exempelvis: 200 kr/tim × 40 tim × 52 / 12 = 34 667 kr/mån.' },
  { question: 'Hur många timmar arbetar man normalt per månad?', answer: 'En heltidstjänst i Sverige är normalt 40 timmar per vecka, vilket ger cirka 173 timmar per månad (40 × 52 / 12).' },
  { question: 'Vad är minimilön i Sverige?', answer: 'Sverige har ingen lagstadgad minimilön. Istället regleras löner genom kollektivavtal. Ingångslöner varierar efter bransch, men ligger ofta mellan 22 000 och 26 000 kr per månad.' },
];
---

<CalculatorLayout
  slug="/timlon-kalkylator"
  title="Timlönkalkylator"
  metaTitle="Timlönkalkylator Sverige 2025 | Timlön till månadslön"
  metaDescription="Omvandla timlön till månadslön och beräkna nettolön i Sverige 2025. Se vad du får ut per timme, vecka och månad efter skatt. Gratis kalkylator med aktuell data."
  h1="Timlönkalkylator 2025"
  intro="Omvandla din timlön till månadslön och se vad du får ut efter skatt."
  faqs={faqs}
>
  <TimlonKalkylator client:idle />

  <div slot="content" class="prose prose-lg dark:prose-invert max-w-none mt-12">
    <h2>Timlön till månadslön: omvandlingstabell</h2>
    <p>Baserat på 40 timmars arbetsvecka och genomsnittlig kommunalskatt (32,37%):</p>
    <table>
      <thead><tr><th>Timlön</th><th>Brutto/mån</th><th>Netto/mån (ca)</th><th>Netto/tim (ca)</th></tr></thead>
      <tbody>
        <tr><td>150 kr</td><td>26 000 kr</td><td>~20 600 kr</td><td>~119 kr</td></tr>
        <tr><td>175 kr</td><td>30 333 kr</td><td>~23 600 kr</td><td>~136 kr</td></tr>
        <tr><td>200 kr</td><td>34 667 kr</td><td>~26 600 kr</td><td>~153 kr</td></tr>
        <tr><td>250 kr</td><td>43 333 kr</td><td>~32 400 kr</td><td>~187 kr</td></tr>
        <tr><td>300 kr</td><td>52 000 kr</td><td>~37 500 kr</td><td>~216 kr</td></tr>
        <tr><td>400 kr</td><td>69 333 kr</td><td>~45 000 kr</td><td>~260 kr</td></tr>
      </tbody>
    </table>
    <p><em>Ungefärliga belopp. Nettolönen varierar med kommun och kyrkoavgift.</em></p>
  </div>
</CalculatorLayout>
