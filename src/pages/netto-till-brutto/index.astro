---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import NettoTillBruttoKalkylator from '../../components/calculators/NettoTillBruttoKalkylator';

const faqs = [
  {
    question: "När är en netto-till-brutto-beräkning användbar?",
    answer:
      "När kravet är formulerat i nettotermer: en hyra som ska täckas, ett lånelöfte, eller en löneförhandling där du vet vad du behöver på kontot varje månad. Att räkna framlänges från brutto svarar på en annan fråga, och att växla mellan de två i huvudet blir sällan rätt.",
  },
  {
    question: "Hur exakt är resultatet?",
    answer:
      "På kronan för en vanlig anställning med standardavdrag. Eftersom sambandet mellan brutto och netto inte är linjärt söker beräkningen sig fram i stället för att använda en formel. Jämkning, skattepliktiga förmåner eller ett kommunbyte mitt under året förskjuter resultatet, och inget av det kan förutses av ett verktyg som bara känner till bruttolönen.",
  },
  {
    question: "Påverkar kommunen vilket brutto jag behöver?",
    answer:
      "Ja, tydligt. Statlig skatt och allmän pensionsavgift är desamma i hela landet, så hela skillnaden kommer från kommunalskatten. På en medianlön kan skillnaden mellan den lägsta och den högsta kommunen motsvara flera tusen kronor i brutto för samma nettolön, vilket är värt att räkna på inför en flytt.",
  },
  {
    question: "Kan jag använda den för ett konsultarvode?",
    answer:
      "Delvis. Den ger motsvarande anställningslön, men en egenföretagare betalar egenavgifter, saknar semesterlön och har ingen tjänstepension från någon annan. Ett vanligt påslag för att komma i nivå med en anställning ligger på trettio till femtio procent utöver det belopp verktyget visar.",
  },

  { question: 'Hur räknar jag ut brutto från netto?', answer: 'Vår kalkylator gör en omvänd beräkning. Ange din önskade nettolön och se vilken bruttolön du behöver. Beräkningen tar hänsyn till kommunalskatt, eventuell statlig skatt, jobbskatteavdrag och grundavdrag. Beräkningen görs bakvänt eftersom sambandet inte är linjärt: grundavdrag, jobbskatteavdrag och skiktgräns skapar trappsteg som ingen enkel formel kan vända. Verktyget söker sig fram till det bruttobelopp som ger exakt det netto du angett.' },
  { question: 'Varför kan jag inte bara dela netto med (1 - skattesats)?', answer: 'Sveriges progressiva skattesystem med grundavdrag, jobbskatteavdrag och statlig skatt gör det omöjligt att använda en enkel formel. Kalkylatorn använder binär sökning för att hitta rätt bruttolön. Skattesatsen är inte densamma på hela lönen. Grundavdrag och jobbskatteavdrag gör att den effektiva skatten stiger med inkomsten, och över skiktgränsen tillkommer statlig skatt. En division med en genomsnittssats ger därför alltid fel svar.' },
];
import OfficiellaKallor from '../../components/OfficiellaKallor.astro';
import SkattKontext from '../../components/SkattKontext.astro';
---

<CalculatorLayout
  slug="/netto-till-brutto"
  title="Netto till brutto"
  metaTitle="Netto till Brutto-kalkylator 2026 | Omvänd löneberäkning"
  metaDescription="Räkna ut vilken bruttolön du behöver för att nå en önskad nettolön i Sverige 2026. Omvänd kalkylator med Skatteverkets data, kommunalskatt och jobbskatteavdrag."
  h1="Netto till brutto-kalkylator 2026"
  intro="Ange din önskade nettolön och se vilken bruttolön du behöver. Tar hänsyn till kommunalskatt, statlig skatt och jobbskatteavdrag."
  faqs={faqs}
>
  <NettoTillBruttoKalkylator client:idle />

  <div slot="content" class="prose prose-lg dark:prose-invert max-w-none mt-12">
    <h2>Netto till brutto: exempeltabell</h2>
    <p>Baserat på genomsnittlig kommunalskatt (32,37%), ingen kyrkoavgift:</p>
    <table>
      <thead><tr><th>Önskad nettolön</th><th>Bruttolön krävs</th><th>Total skatt</th></tr></thead>
      <tbody>
        <tr><td>20 000 kr/mån</td><td>~25 500 kr/mån</td><td>~5 500 kr</td></tr>
        <tr><td>25 000 kr/mån</td><td>~33 000 kr/mån</td><td>~8 000 kr</td></tr>
        <tr><td>30 000 kr/mån</td><td>~41 000 kr/mån</td><td>~11 000 kr</td></tr>
        <tr><td>35 000 kr/mån</td><td>~49 000 kr/mån</td><td>~14 000 kr</td></tr>
        <tr><td>40 000 kr/mån</td><td>~59 000 kr/mån</td><td>~19 000 kr</td></tr>
      </tbody>
    </table>
    <p><em>Ungefärliga belopp. Välj din kommun i kalkylatorn ovan för exakt resultat.</em></p>
  </div>
  <OfficiellaKallor />
  <SkattKontext />
</CalculatorLayout>
