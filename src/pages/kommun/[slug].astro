---
import { formatDec } from '../../lib/format';
import { KOMMUN_AVSNITT } from '../../data/angles-lokalt';
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import LonKalkylator from '../../components/calculators/LonKalkylator';
import { KOMMUNER, KOMMUNER_MED_SIDA, SALARY_AMOUNTS } from '../../data/tax-2026';
import { calculateTakeHome } from '../../lib/tax-engine-se';

/** Le taux s'ecrit a la suedoise, virgule decimale, dans le texte ET dans le JSON-LD. */


const taux = (v: number) => v.toLocaleString('sv-SE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });


export function getStaticPaths() {
  return KOMMUNER.filter((k) => KOMMUNER_MED_SIDA.includes(k.slug)).map((kommun) => ({
    params: { slug: kommun.slug },
    props: { kommun },
  }));
}

const { kommun } = Astro.props;

/* Rang de la commune et ecart avec la moyenne, pour des reponses qui different. */
const _tri = [...KOMMUNER].sort((a, b) => a.rate - b.rate);
const _rang = _tri.findIndex((k) => k.slug === kommun.slug) + 1;
const _moyenne = KOMMUNER.reduce((s, k) => s + k.rate, 0) / KOMMUNER.length;
const _ecartPts = kommun.rate - _moyenne;

const salaryTable = SALARY_AMOUNTS.map((gross) => {
  const result = calculateTakeHome({ monthlyGross: gross, kommunalskattRate: kommun.rate });
  return { gross, net: result.netMonthly, tax: Math.round(result.totalSkatt / 12), rate: result.effectiveTaxRate };
});

const faqs = [
  { question: `Vad är kommunalskatten i ${kommun.name} 2026?`, answer: `Kommunalskatten i ${kommun.name} är ${taux(kommun.rate)} % (2026). Det inkluderar både kommunens och ${kommun.lan}s regionskatt. Det placerar ${kommun.name} på plats ${_rang} av ${KOMMUNER.length} bland de kommuner vi följer, ${_ecartPts >= 0 ? `omkring ${taux(Math.abs(_ecartPts))} procentenheter över` : `omkring ${taux(Math.abs(_ecartPts))} procentenheter under`} genomsnittet. Kommunfullmäktige beslutar om satsen inför varje budgetår, och regionen lägger sin del ovanpå.` },
  { question: `Hur mycket nettolön får jag i ${kommun.name}?`, answer: `Med en bruttolön på 35 000 kr per månad och ${kommun.name}s kommunalskatt på ${taux(kommun.rate)} % får du ungefär ${salaryTable.find(s => s.gross === 35000)?.net.toLocaleString('sv-SE')} kr netto per månad efter skatt. Beloppet förutsätter ingen kyrkoavgift och inga avdrag utöver grundavdrag och jobbskatteavdrag, som båda räknas in automatiskt i skattetabellen. Statlig inkomstskatt tillkommer först över skiktgränsen och påverkar alltså inte den här lönenivån.` },
  { question: `Betalar jag statlig skatt i ${kommun.name}?`, answer: `Statlig inkomstskatt (20%) är densamma oavsett kommun och betalas på beskattningsbar inkomst över 615 300 kr per år. Det som skiljer mellan kommuner är kommunalskattesatsen. Skiktgränsen räknas upp varje år enligt inkomstbasbeloppet, så den flyttar sig även när riksdagen inte fattat något nytt beslut. För de flesta löntagare i ${kommun.name} ligger den utom räckhåll, vilket gör kommunalskatten till hela skatten på lönen.` },
];
import OfficiellaKallor from '../../components/OfficiellaKallor.astro';
import SkattKontext from '../../components/SkattKontext.astro';
---

<CalculatorLayout
  slug={`/kommun/${kommun.slug}`}
  title={`Lönekalkylator ${kommun.name}`}
  metaTitle={`Lön efter skatt i ${kommun.name} 2026, ${taux(kommun.rate)} % kommunalskatt i ${kommun.lan}`.slice(0, 60)}
  metaDescription={`Beräkna din nettolön i ${kommun.name} med ${taux(kommun.rate)} % kommunalskatt. Se lön efter skatt för alla lönenivåer i kommunen 2026. Gratis kalkylator med Skatteverkets data.`}
  h1={`Lön efter skatt i ${kommun.name} 2026`}
  intro={`Beräkna din nettolön i ${kommun.name} med ${taux(kommun.rate)} % kommunalskatt (${kommun.lan}). Uppdaterad med Skatteverkets 2026-data.`}
  faqs={faqs}
>
  <div data-chrome>
    <LonKalkylator client:idle initialGross={35000} />
  </div>

  {/* §6.4 : ce bloc ne varie que par le nom et le taux, que le contrôle
      neutralise : c'est du mobilier, pas du contenu propre à la page. */}
  <div slot="content" data-chrome class="prose prose-lg dark:prose-invert max-w-none mt-12">
    <h2>Lönetabell {kommun.name} 2026</h2>
    <p>Nettolön i {kommun.name} med {kommun.rate}% kommunalskatt, ingen kyrkoavgift:</p>
    <table>
      <thead><tr><th>Bruttolön/mån</th><th>Nettolön/mån</th><th>Skatt/mån</th><th>Effektiv skatt</th></tr></thead>
      <tbody>
        {salaryTable.map((row) => (
          <tr>
            <td>{row.gross.toLocaleString('sv-SE')} kr</td>
            <td>{row.net.toLocaleString('sv-SE')} kr</td>
            <td>{row.tax.toLocaleString('sv-SE')} kr</td>
            <td>{formatDec(row.rate, 1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Skattesats i {kommun.name}</h2>
    <p>{kommun.name} tillhör {kommun.lan} och har en total kommunalskattesats på {kommun.rate}%. Det placerar {kommun.name} {kommun.rate < 32.37 ? 'under' : kommun.rate > 32.37 ? 'över' : 'nära'} riksgenomsnittet på 32,37%.</p>
  </div>
  <OfficiellaKallor />
  <SkattKontext />
  <section slot="content" class="mt-12">
    {(KOMMUN_AVSNITT[kommun.slug] ?? []).map((a) => (
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">{a.rubrik}</h2>
        {a.stycken.map((p) => <p class="mb-4 text-gray-700 leading-relaxed dark:text-gray-300">{p}</p>)}
      </div>
    ))}
  </section>
</CalculatorLayout>
