---
import '../styles/global.css';
import { RESUMES } from '../data/resumes';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE_URL, OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT } from '../data/site-config';
import { getAlternatePath } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  modifiedDate?: string;
  breadcrumbs: { label: string; href?: string }[];
  lang?: string;
  /**
   * Questions de la page. Affichees ET declarees en `FAQPage` depuis cette
   * seule source, de sorte que le balisage ne puisse pas promettre a Google un
   * texte absent de la page (RECETTE §7).
   */
  faqs?: { question: string; answer: string }[];
  /**
   * Paragraphe citable (RECETTE §21) : au moins 120 mots, rendus dans le
   * corps et non dans l'en-tete, que check-seo retire comme un ornement.
   */
  resume?: string;
}

const { title, description, publishDate, modifiedDate, breadcrumbs, lang = 'sv', faqs = [] , resume} = Astro.props;
const resumeAffiche = resume ?? RESUMES[Astro.url.pathname]
  ?? RESUMES[Astro.url.pathname.replace(/\/$/, '') + '/'];

const faqPageSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;

const currentPath = Astro.url.pathname;
const altPath = getAlternatePath(currentPath, lang as 'sv' | 'en');
const svPath = lang === 'sv' ? canonicalUrl : altPath ? `${SITE_URL}${altPath}` : null;
const enPath = lang === 'en' ? canonicalUrl : altPath ? `${SITE_URL}${altPath}` : null;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Hreflang -->
  {svPath && <link rel="alternate" hreflang="sv" href={svPath} />}
  {enPath && <link rel="alternate" hreflang="en" href={enPath} />}
  {svPath && <link rel="alternate" hreflang="x-default" href={svPath} />}

  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={lang === 'sv' ? 'sv_SE' : 'en_US'} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta property="og:image:alt" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-dark-bg text-gray-900 dark:text-gray-100 antialiased">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-gray-900 focus:rounded focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500">{lang === 'en' ? 'Skip to main content' : 'Hoppa till huvudinnehåll'}</a>
  <Header lang={lang} />
  <main id="main-content" class="flex-1 mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:py-12">
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      {breadcrumbs.map((item, i) => (
        <>
          {i > 0 && <span class="mx-2">/</span>}
          {item.href ? <a href={item.href} class="hover:text-brand-600 dark:hover:text-brand-400">{item.label}</a> : <span class="text-gray-900 dark:text-white">{item.label}</span>}
        </>
      ))}
    </nav>
    <article class="prose prose-lg dark:prose-invert max-w-none">
      <header class="not-prose mb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">{title}</h1>
        <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{description}</p>
        <div class="flex items-center gap-4 mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
          <div class="flex-shrink-0 h-10 w-10 rounded-full bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-brand-600 dark:text-brand-400 font-bold text-sm">MR</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">
            <p class="font-medium text-gray-900 dark:text-white">Radif Partners</p>
            <p>Publicerad {new Date(publishDate).toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          </div>
        </div>
      </header>
      {resumeAffiche && (
      <p class="mb-8 text-gray-700 leading-relaxed dark:text-gray-300">{resumeAffiche}</p>
      )}
      <slot />

      {faqs.length > 0 && (
        <section class="mt-12 border-t border-gray-200 dark:border-gray-700 pt-8">
          <h2 id="faq">{lang === 'en' ? 'Frequently asked questions' : 'Vanliga frågor'}</h2>
          <div class="mt-6 space-y-4 not-prose">
            {faqs.map((f) => (
              <details class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900">
                <summary class="cursor-pointer px-6 py-4 font-semibold hover:text-brand-600">
                  {f.question}
                </summary>
                <div class="px-6 pb-4 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{f.answer}</div>
              </details>
            ))}
          </div>
        </section>
      )}
      {faqPageSchema && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />}
    </article>
  </main>
  <Footer />
</body>
</html>
