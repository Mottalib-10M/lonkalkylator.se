---
interface Props {
  current?: string;
}

const { current } = Astro.props;

const calculators = [
  { title: 'Lönekalkylator', description: 'Beräkna din lön efter skatt med kommun- och statlig skatt', href: '/' },
  { title: 'Statlig skatt-kalkylator', description: 'Se om du betalar statlig inkomstskatt (20% över skiktgränsen)', href: '/statlig-skatt-kalkylator/' },
  { title: 'Pensionskalkylator', description: 'Beräkna din allmänna pensionsavgift och hur den påverkar nettolönen', href: '/pensionskalkylator/' },
  { title: 'Netto till brutto', description: 'Räkna ut vilken bruttolön du behöver för din önskade nettolön', href: '/netto-till-brutto/' },
  { title: 'Timlönkalkylator', description: 'Omvandla timlön till månadslön och beräkna nettolön', href: '/timlon-kalkylator/' },
];

const related = calculators.filter(c => c.href !== current).slice(0, 4);
---

<section data-chrome class="mt-12" aria-labelledby="related-heading">
  <h2 id="related-heading" class="text-xl font-bold text-gray-900 dark:text-white mb-4">
    Relaterade kalkylatorer
  </h2>
  <div class="grid gap-4 sm:grid-cols-2">
    {related.map((calc) => (
      <a href={calc.href} class="group rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-dark-surface p-5 hover:border-brand-500 dark:hover:border-brand-400 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
          {calc.title}
        </h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{calc.description}</p>
      </a>
    ))}
  </div>
</section>
